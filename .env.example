# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="my_gemini_api_key"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# JWT_SECRET: Secret key for signing JWT tokens.
# IMPORTANT: Change this in production. Use a strong, random string.
JWT_SECRET="change-me-in-production-use-strong-random-key"

# ===== WhatsApp Business API =====
# WHATSAPP_API_TOKEN: Your WhatsApp Business API access token
# Get this from Meta Business Manager > System User > Tokens
# https://www.meta.com/en/business/tools/meta-business-platform/
WHATSAPP_API_TOKEN="your_whatsapp_api_token"

# WHATSAPP_PHONE_ID: Your WhatsApp Phone Number ID
# Get this from App Dashboard > WhatsApp > Phone Numbers
WHATSAPP_PHONE_ID="your_phone_id"

# WHATSAPP_BUSINESS_ACCOUNT_ID: Your WhatsApp Business Account ID
# Get this from App Dashboard > WhatsApp > Settings
WHATSAPP_BUSINESS_ACCOUNT_ID="your_business_account_id"

# WHATSAPP_WEBHOOK_TOKEN: Secret token for webhook verification
# Create any random string for webhook security
WHATSAPP_WEBHOOK_TOKEN="whatcart_webhook_token_secret"

# ===== Twilio (Optional - for SMS verification) =====
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"

# ===== Email Service (Optional - for notifications) =====
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_app_password"

# ===== Stripe (Optional - for payments) =====
STRIPE_SECRET_KEY="sk_test_your_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_key"

# ===== Shopify Integration =====
# To connect WhatCart to Shopify stores for abandoned cart recovery

# SHOPIFY_API_KEY: Your app's API key
# Get from: Shopify Partner Dashboard > Apps > Your App > Configuration
SHOPIFY_API_KEY="your_shopify_api_key"

# SHOPIFY_API_SECRET: Your app's API secret
# IMPORTANT: Keep this secret! Never commit to git.
SHOPIFY_API_SECRET="your_shopify_api_secret"

# SHOPIFY_SCOPES: Required OAuth scopes
# Separate multiple with comma: read_orders,write_checkouts,read_customers
SHOPIFY_SCOPES="read_orders,read_checkouts,read_customers"

# Flow:
# 1. User clicks "Connect Shopify Store" 
# 2. Redirected to: https://SHOPIFY_API_KEY.myshopify.com/admin/oauth/authorize?...
# 3. User authorizes
# 4. Redirected back to: {APP_URL}/api/shopify/auth/callback?code=...
# 5. WhatCart exchanges code for access token
# 6. Access token stored in database
# 7. Webhooks automatically created for:
#    - checkouts/create (new cart)
#    - checkouts/update (cart modified)
#    - orders/create (recovery confirmed)

